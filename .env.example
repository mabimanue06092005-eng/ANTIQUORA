# ─────────────────────────────────────────────────────────────
# ANTIQUORA environment configuration
# Copy to `.env` in the repository root:  cp .env.example .env
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
API_PORT=4000

# PostgreSQL connection.
# `npm run db:local` starts an embedded PostgreSQL on port 5433 with these credentials.
# With docker compose (`docker compose up -d db`) use port 5432 instead.
DATABASE_URL=postgresql://antiquora:antiquora@localhost:5433/antiquora?schema=public

# Session signing secret — use a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Comma-separated list of origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

# Public URL of the storefront (used for sitemap, canonical URLs, Open Graph).
PUBLIC_SITE_URL=http://localhost:5173

# Session lifetime in days.
SESSION_TTL_DAYS=14

# Payments ─ "demo" uses the built-in simulated gateway (no real money moves).
# Set to "razorpay" and provide keys below to enable the real Razorpay flow.
PAYMENT_PROVIDER=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (optional). When SMTP is not configured, emails are written to the API log
# in development instead of being sent.
SMTP_URL=
MAIL_FROM="ANTIQUORA <no-reply@example.com>"

# Development-only admin bootstrap (used by `npm run admin:create`).
# Leave blank to be prompted / to have a random password generated and printed once.
ADMIN_EMAIL=
ADMIN_PASSWORD=
